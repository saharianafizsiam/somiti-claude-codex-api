DATABASE_URL=
AUTH_SECRET=
# Set only during a planned AUTH_SECRET rotation, then remove after legacy
# sessions, API keys, and codes have been replaced or intentionally disabled.
AUTH_SECRET_PREVIOUS=
APP_URL=http://localhost:3000
API_URL=http://localhost:3000
UPSTREAM_PROVIDER=mwapi
MWAPI_BASE_URL=https://api.mwapi.dev
MWAPI_API_KEY=
# Confirm paths with your provider. No endpoint is assumed.
MWAPI_CHAT_PATH=
MWAPI_MESSAGES_PATH=
MWAPI_AUTH_HEADER=Authorization
MWAPI_AUTH_PREFIX=Bearer
# Separate provider credentials. Verify the API origin and paths with its documentation.
CLAUDE_N_CODEX_BASE_URL=https://claude-n-codex.com:8443
CLAUDE_N_CODEX_CLAUDE_API_KEY=
CLAUDE_N_CODEX_OPENAI_API_KEY=
CLAUDE_N_CODEX_CHAT_PATH=/v1/chat/completions
CLAUDE_N_CODEX_MESSAGES_PATH=/v1/messages
CLAUDE_N_CODEX_MODELS_PATH=/v1/models
MWAPI_MODELS_PATH=/v1/models
CLAUDE_N_CODEX_AUTH_HEADER=Authorization
CLAUDE_N_CODEX_AUTH_PREFIX=Bearer
API_KEY_ENCRYPTION_SECRET=
# Set only during a planned encryption-key rotation, then remove after the
# database migration in docs/secret-rotation.md has completed.
API_KEY_ENCRYPTION_PREVIOUS_SECRET=
OWNER_EMAIL=
OWNER_USERNAME=
OWNER_PASSWORD=
CRON_SECRET=
UPSTASH_REDIS_REST_URL=

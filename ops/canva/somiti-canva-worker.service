[Unit]
Description=Serial Canva invitation worker
After=network-online.target somiti-canva-browser.service
Wants=network-online.target somiti-canva-browser.service
ConditionPathExists=/etc/somiti-canva-worker.env
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=somiti-canva
Group=somiti-canva
WorkingDirectory=/opt/somiti-canva
Environment=HOME=/var/lib/somiti-canva
EnvironmentFile=/etc/somiti-canva-worker.env
ExecStart=/usr/bin/node /opt/somiti-canva/worker.mjs
Restart=on-failure
RestartSec=20
MemoryHigh=96M
MemoryMax=144M
MemorySwapMax=32M
CPUQuota=20%
TasksMax=128
OOMScoreAdjust=600
Nice=10
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/somiti-canva
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=Isolated Canva owner-login browser
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=somiti-canva
Group=somiti-canva
WorkingDirectory=/opt/somiti-canva
Environment=HOME=/var/lib/somiti-canva
ExecStart=/bin/bash /opt/somiti-canva/start-browser.sh
Restart=on-failure
RestartSec=15
KillMode=control-group
TimeoutStopSec=20
MemoryHigh=650M
MemoryMax=800M
MemorySwapMax=128M
CPUQuota=50%
TasksMax=512
OOMScoreAdjust=500
Nice=10
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/somiti-canva
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
